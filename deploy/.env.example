# TDTUOJ app secrets + config. Copy to .env on the VM and fill real values.
# This file (.env) is gitignored — never commit real secrets.

# ---- Domain (used by Caddy for auto-HTTPS). Point its DNS A record at the VM IP. ----
DOMAIN=api.example.com

# ---- Application Postgres (compose builds the JDBC URL from these) ----
APP_DB_USER=admin
APP_DB_PASSWORD=CHANGE_ME_app_db_password

# ---- JWT signing secret (>= 32 chars) ----
SECRET_JWT_STRING=CHANGE_ME_long_random_secret_at_least_32_chars

# ---- AWS S3 (or Cloudflare R2 with S3-compatible creds) ----
AWS_S3_REGION=ap-southeast-1
AWS_S3_BUCKET=tdtu-oj
AWS_S3_ACCESS_KEY=CHANGE_ME
AWS_S3_SECRET_KEY=CHANGE_ME

# ---- LLM API keys ----
ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME

# ---- Google OAuth client id (for Google sign-in) ----
GOOGLE_CLIENT_ID=CHANGE_ME
