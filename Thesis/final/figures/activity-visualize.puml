@startuml activity-visualize
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundCorner 0
skinparam ArrowColor #000000
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #000000
skinparam ActivityFontColor #000000
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #000000
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneBorderColor #000000

|User|
start
:Open problem in the IDE;
:Write code & select language\nPython / JS / Java / C# / C / C++;
:Click "Visualize";

|System|
:Pick language tracer;
:Transform source so it emits\nexecution frames when run;
fork
  :Send transformed code\nto judging service;
  :Run code in sandbox,\ncapture frame stream;
fork again
  :Classify variable roles via LLM\ngraph / tree / DP table / ...;
end fork

if (Compile / run OK?) then (Yes)
  :Parse frame stream into steps\ncall stack + heap per step;
  :Return steps + classifications;
  |User|
  repeat
    :View step in renderer\narray / tree / graph / ...;
    :Step forward / back\nor play animation;
  repeat while (Inspect more steps?) is (Yes) not (No)
  :Close visualizer;
else (No)
  :Return compile / runtime error;
  |User|
  :Show error message;
  :Fix code;
  stop
endif
stop
@enduml
