@startuml seq-visualize
mainframe sd Visualize and debug code
hide footbox
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam SequenceArrowColor #000000
skinparam SequenceLifeLineBorderColor #000000
skinparam SequenceGroupBorderColor #000000
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam BoundaryBackgroundColor #FFFFFF
skinparam BoundaryBorderColor #000000
skinparam ControlBackgroundColor #FFFFFF
skinparam ControlBorderColor #000000
skinparam EntityBackgroundColor #FFFFFF
skinparam EntityBorderColor #000000

autonumber

actor "User" as U
boundary "Visualizer Panel" as UI
control "VisualizerController" as C
control "VisualizerService" as S
control "Tracer" as T
control "VariableClassifier" as VC
control "Judge0" as J

U -> UI : Write code, select language
activate UI
U -> UI : Click "Visualize"
UI -> C : POST /api/visualize
activate C
C -> S : visualize(code, language)
activate S
S -> T : instrument(code)
activate T
T -> T : Rewrite source to emit\nframe stream on stderr
T --> S : transformed code
deactivate T

par
  S -> J : run transformed code
  activate J
  J -> J : compile & execute in sandbox
  J --> S : stdout + stderr (frames)
  deactivate J
else
  S -> VC : classify(code) async
  activate VC
  VC -> VC : Gemini labels variable roles\n(Redis-cached, 3s budget)
  VC --> S : classifications (or empty)
  deactivate VC
end

alt Compile / run OK
  S -> S : Parse frames JSON from stderr\ninto step list
  S --> C : VisualizerResponse\n(frames + classifications)
  deactivate S
  C --> UI : 200 frames
  deactivate C
  loop for each step
    U -> UI : Step / play animation
    UI --> U : Render data structure
  end
else Error
  S --> C : error message
  C --> UI : error response
  UI --> U : Show compile / runtime error
end
deactivate UI
@enduml
