@startuml activity-participate-contest
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundCorner 0
skinparam ArrowColor #000000
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #000000
skinparam ActivityFontColor #000000
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #000000
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneBorderColor #000000

|User|
start
:Open contest detail page;
:Click "Register";
|System|
if (Window open, not full,\nnot already registered?) then (Yes)
  :Create registration\nstatus = APPROVED;
else (No)
  |User|
  :Show rejection reason;
  stop
endif

|User|
:Wait for contest to start;
:Open contest problem;

repeat
  :Write solution & submit;
  |System|
  :Judge submission\nscore by style (ICPC);
  :Hide submission from\nother participants;
  if (Inside freeze window?) then (Yes)
    :Serve frozen scoreboard\nto public viewers;
  else (No)
    :Update live scoreboard;
  endif
  |User|
  :View verdict & live rank;
repeat while (Solve more / retry?) is (Yes) not (No)

|System|
:Contest ends;
:Process ratings\nupdate rating history;
:Unlock submissions\nauto-publish contest problems;
|User|
:View final leaderboard & rating;
stop
@enduml
