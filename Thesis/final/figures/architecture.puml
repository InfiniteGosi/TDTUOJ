@startuml architecture
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundCorner 8
skinparam ArrowColor #333333
skinparam ArrowFontColor #333333
skinparam rectangleBorderColor #000000
skinparam packageBorderColor #555555
skinparam packageFontStyle bold
skinparam actorBorderColor #000000
skinparam actorBackgroundColor #FFFFFF
skinparam databaseBackgroundColor #FFF3E0
skinparam databaseBorderColor #000000
skinparam queueBackgroundColor #FFF3E0
skinparam queueBorderColor #000000
skinparam nodeBackgroundColor #FFF8E1
skinparam nodeBorderColor #000000
skinparam cloudBackgroundColor #F3E5F5
skinparam cloudBorderColor #000000

actor "User" as student
actor "Admin/Creator" as creator

package "Frontend" #E3F2FD {
  rectangle "Browser — React SPA (Vite)\nMonaco Editor, Chakra UI, Bootstrap" as spa #FFFFFF
}

package "Backend — Spring Boot" #E8F5E9 {
  rectangle "Security\nJWT · CORS" as sec #FFFFFF
  rectangle "REST Controllers" as ctrl #FFFFFF
  rectangle "Service layer\n(Business logic)" as svc #FFFFFF
  rectangle "Submission Worker\n(chấm bài bất đồng bộ)" as worker #FFFFFF
  rectangle "WebClient (WebFlux)" as webclient #FFFFFF
}

package "Storage & Cache" #FFF3E0 {
  database "PostgreSQL" as pg
  queue "Redis\nqueue + cache" as redis
}

package "External Services" #F3E5F5 {
  node "Judge0 (Docker)" as judge0
  cloud "AWS S3\nstorage" as s3
  cloud "Gemini LLM API" as gemini
}

student  --> spa : HTTPS
creator  --> spa : HTTPS
spa      --> sec : REST / JSON (HTTPS)
sec      --> ctrl
ctrl     --> svc
svc      --> pg       : JPA / JDBC
svc      --> redis    : cache + push queue
worker   --> redis    : retrieve submissions
worker   --> webclient
svc      --> s3       : AWS SDK (problem statement, test cases)
webclient --> judge0  : HTTP (compile, judge)
webclient --> gemini  : HTTPS (suggest, PDF extract)

@enduml
