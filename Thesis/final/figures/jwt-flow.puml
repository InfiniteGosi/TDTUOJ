@startuml jwt-flow
mainframe sd JWT authentication
hide footbox
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam SequenceArrowColor #000000
skinparam SequenceLifeLineBorderColor #000000
skinparam SequenceGroupBorderColor #000000
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam BoundaryBackgroundColor #FFFFFF
skinparam BoundaryBorderColor #000000
skinparam ControlBackgroundColor #FFFFFF
skinparam ControlBorderColor #000000
skinparam EntityBackgroundColor #FFFFFF
skinparam EntityBorderColor #000000
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #000000

autonumber

actor "User" as U
boundary "React SPA" as UI
control "AuthController" as AC
control "JwtUtils" as JW
control "AuthFilter" as F
control "REST Controller" as C
database "PostgreSQL" as DB

group Login
  U -> UI : Enter credentials
  activate UI
  UI -> AC : POST /api/auth/login
  activate AC
  AC -> DB : Find user, verify\nBCrypt password hash
  activate DB
  DB --> AC : user record
  deactivate DB
  AC -> JW : generateToken(email)
  activate JW
  JW -> JW : Sign with HMAC-SHA256\nsubject, issued-at, expiry
  JW --> AC : JWT
  deactivate JW
  AC --> UI : 200 + JWT
  deactivate AC
  UI -> UI : Store token (localStorage)
  UI --> U : Logged in
  deactivate UI
end

group Authenticated request
  U -> UI : Perform action
  activate UI
  UI -> F : Request with header\nAuthorization: Bearer <JWT>
  activate F
  F -> JW : validate(token)
  activate JW
  JW -> JW : Check signature & expiry
  JW --> F : claims (email)
  deactivate JW

  alt Token valid
    F -> DB : Load user & roles
    activate DB
    DB --> F : user details
    deactivate DB
    F -> F : Set SecurityContext
    F -> C : forward request
    activate C
    C -> C : @PreAuthorize role check
    C --> UI : 200 response
    deactivate C
  else Token invalid / expired
    F --> UI : 401 Unauthorized
  end
  deactivate F
  UI --> U : Show result
  deactivate UI
end
@enduml
