{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "TDTUOJ — Load & Health",
  "uid": "tdtuoj-load-health",
  "tags": ["tdtuoj"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    { "type": "row", "title": "HTTP", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },
    {
      "type": "timeseries", "title": "Request rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{application=\"tdtuoj\"}[1m]))", "legendFormat": "total" },
        { "refId": "B", "expr": "sum(rate(http_server_requests_seconds_count{application=\"tdtuoj\"}[1m])) by (uri)", "legendFormat": "{{uri}}" }
      ]
    },
    {
      "type": "timeseries", "title": "Latency p95 by URI (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"tdtuoj\"}[1m])) by (le, uri))", "legendFormat": "{{uri}}" }
      ]
    },
    {
      "type": "timeseries", "title": "Error rate (5xx / 4xx, req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{application=\"tdtuoj\",status=~\"5..\"}[1m]))", "legendFormat": "5xx" },
        { "refId": "B", "expr": "sum(rate(http_server_requests_seconds_count{application=\"tdtuoj\",status=~\"4..\"}[1m]))", "legendFormat": "4xx" }
      ]
    },

    { "type": "row", "title": "JVM", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "collapsed": false },
    {
      "type": "timeseries", "title": "Heap used (bytes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{application=\"tdtuoj\",area=\"heap\"})", "legendFormat": "heap used" },
        { "refId": "B", "expr": "sum(jvm_memory_max_bytes{application=\"tdtuoj\",area=\"heap\"})", "legendFormat": "heap max" }
      ]
    },
    {
      "type": "timeseries", "title": "GC pause rate (s/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(jvm_gc_pause_seconds_sum{application=\"tdtuoj\"}[1m]))", "legendFormat": "gc pause/s" }
      ]
    },
    {
      "type": "timeseries", "title": "Live threads",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "jvm_threads_live_threads{application=\"tdtuoj\"}", "legendFormat": "live" }
      ]
    },

    { "type": "row", "title": "Rate limit", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }, "collapsed": false },
    {
      "type": "timeseries", "title": "Allowed by tier (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(ratelimit_allowed_total{application=\"tdtuoj\"}[1m])) by (tier)", "legendFormat": "{{tier}}" }
      ]
    },
    {
      "type": "timeseries", "title": "Denied by tier (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(ratelimit_denied_total{application=\"tdtuoj\"}[1m])) by (tier)", "legendFormat": "{{tier}}" }
      ]
    },

    { "type": "row", "title": "Judging", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }, "collapsed": false },
    {
      "type": "timeseries", "title": "Submission queue depth",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "submissions_queue_depth{application=\"tdtuoj\"}", "legendFormat": "queue depth" }
      ]
    },
    {
      "type": "timeseries", "title": "Judged rate by verdict (1/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(submissions_judged_total{application=\"tdtuoj\"}[1m])) by (verdict)", "legendFormat": "{{verdict}}" }
      ]
    },
    {
      "type": "timeseries", "title": "Judge latency p95 (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(submissions_judge_duration_seconds_bucket{application=\"tdtuoj\"}[1m])) by (le))", "legendFormat": "p95" }
      ]
    }
  ]
}
